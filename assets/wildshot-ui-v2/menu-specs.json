    {
      "id": "spec_guide",
      "name": "📖 spec guide",
      "chrome": "panel",
      "w": 480,
      "h": 330,
      "title": "menu spec — the schema",
      "close": true,
      "scroll": true,
      "blocks": [
        {
          "kind": "text",
          "text": "a menu is one JSON object. paste one in the editor, APPLY draws it, SAVE keeps it in your library.",
          "color": "bright"
        },
        {
          "kind": "gap",
          "h": 6
        },
        {
          "kind": "rule",
          "label": "panel fields"
        },
        {
          "kind": "text",
          "text": "id · name · chrome: panel | popup | inset | tooltip | none · w, h (game px; omit h to auto-size) · dx, dy (offset from screen center) · title · title_icon (atlas glyph name) · close: true · scroll: true · hotkey (any single key — opens/toggles the menu) · tabgroup + tab_label (menus sharing a tabgroup render as tabs of ONE window, like character/errands) · tabs: [{label, blocks}] (inline tabs inside one spec) · blocks: [...]"
        },
        {
          "kind": "gap",
          "h": 6
        },
        {
          "kind": "rule",
          "label": "block kinds"
        },
        {
          "kind": "text",
          "text": "text {text|source, color: bright|base|dim|gold, align} · rule {label|source} · gap {h} · stats {source|rows} · grid {source|cells:[{icon, line, tip, action, badge}]} — square item slots, tooltip on hover, drag to move · questlog {} — master list + detail pane over the demo quest state · list {source|rows, empty} — literal list rows take {line, tip, action, icon} where icon is an atlas glyph name · pairs {source|rows} · toggles {source|rows} · buttons {items:[{label, action, primary, disabled}]} · columns {cols:[{w, blocks}]} · reward {gold, xp} · bars {hp, mana} · input {placeholder} · swatches {items} · icons {names}"
        },
        {
          "kind": "gap",
          "h": 6
        },
        {
          "kind": "rule",
          "label": "live sources (wired to the demo state)"
        },
        {
          "kind": "text",
          "text": "stats · equipment · bag · bank · bank_bag · buy · sell · loot (grid or list sources) · quest_log · remaps · options_toggles · options_cycles — plus header sources: bag_head, bank_head, bank_bag_head, vendor_head, loot_head, quest_caps"
        },
        {
          "kind": "gap",
          "h": 6
        },
        {
          "kind": "rule",
          "label": "actions (buttons + list rows)"
        },
        {
          "kind": "text",
          "text": "close · open:<id> · toast:<msg> · confirm:<msg>|<action>|<icon>|<tip line 1>|<tip line 2> (icon + tip lines optional — the icon shows in a slot, hover it for the tip) · accept:<quest_id> · decline · equip:<slot> · dequip:<slot> · drop:<slot> · deposit:<slot> · withdraw:<slot> · buy:<row> · sell:<slot> · loot:<i> · loot_all · ability:<i> · toggle:<key> · cycle:<key> · capture:<action>"
        },
        {
          "kind": "gap",
          "h": 6
        },
        {
          "kind": "text",
          "text": "hand this schema + one example spec to an AI and ask for a new menu — the renderer draws whatever comes back.",
          "color": "gold"
        },
        {
          "kind": "rule",
          "label": "V2 SET — new-look kinds"
        },
        {
          "kind": "text",
          "text": "chrome: 'panel2' — carved warm frame, gold studs, centered title plaque (title + title_icon) · portrait {} · bigbars {} · statchips {} · dollslots {} · shelf {source: buy|sell} · questlog2 {} (quest cards + parchment detail). Same live sources and actions — copy any v2 spec and remix."
        },
        {
          "kind": "text",
          "text": "legendary:<icon>|<title>|<line> — rare-loot banner: ray burst, pop-in, shine sweep, auto-dismiss ~4.5s. Fire it from any button action.",
          "color": "gold"
        },
        {
          "kind": "text",
          "text": "legendary2:<icon>|<title>|<line> — the long cutscene variant: wolf howl → zoom into the mouth → dragon fire → flame wash → plaque (~8.8s). legendary: is the short heraldic one (~5s).",
          "color": "gold"
        },
        {
          "kind": "text",
          "text": "legendary3:<icon>|<title>|<line> — the stampede: a mob pack rings the screen, the wolf howls beneath them, then the dragon spawns and its flamebreath blasts every mob off-screen before the plaque lands (~7s).",
          "color": "gold"
        },
        {
          "kind": "text",
          "text": "all legendary actions take an optional 4th part: legendary:<icon>|<title>|<line>|<rarity> — the rarity word (default UNIQUE) slams in as a big word-mark above the ribbon.",
          "color": "gold"
        }
      ]
    }
  ]
}