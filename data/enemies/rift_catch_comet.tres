[gd_resource type="Resource" load_steps=12 format=3]

[ext_resource type="Script" path="res://data/enemy_def.gd" id="1"]
[ext_resource type="Script" path="res://data/emitter_slot.gd" id="2"]
[ext_resource type="Script" path="res://data/phase_def.gd" id="3"]
[ext_resource type="Script" path="res://data/phase_list.gd" id="4"]
[ext_resource type="Resource" path="res://data/enemies/patterns/star_spray_comet.tres" id="5"]
[ext_resource type="Resource" path="res://data/enemies/patterns/rift_ring.tres" id="6"]
[ext_resource type="Resource" path="res://data/enemies/patterns/star_dart.tres" id="7"]

; COMET FIELD catch, COMMON (sl-0115): the ONE rift kit with the
; comet twists — spray at 6.3 t/s (star_spray_comet, same pattern id
; 26, same lead 24) and the dart cooldown x0.8 (150 -> 120).
; Everything else byte-matches rift_catch.tres.

[sub_resource type="Resource" id="p1_spray"]
script = ExtResource("2")
pattern = ExtResource("5")
trigger_range = 9.0
telegraph_ticks = 24
cooldown_ticks = 96
recover_ticks = 16

[sub_resource type="Resource" id="p2_spray"]
script = ExtResource("2")
pattern = ExtResource("5")
trigger_range = 9.0
