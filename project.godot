; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; ENGINE PIN: Godot 4.6.2 stable (see CLAUDE.md — upgrades only between Gate 1 cycles).

config_version=5

[application]

config/name="Wildshot Adventures"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

Config="*res://autoload/config.gd"

[display]

; Fullscreen default: windowed-mode compositing produced measured 25-30ms
; stall clusters on the dev machine (632 spikes/session, sim at 0.1 ms —
; spikes.jsonl evidence 2026-07-27). Alt+Enter toggles back to windowed.
window/size/mode=3
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
; frame_queue_size stays at the default 2: a 1-frame queue was tried for
; latency (2026-07-27) and amplified perceived stutter — with no buffer
; slack, every minor OS/driver stall becomes a visible hitch. Latency
; feel belongs to the §6 item 1 A/B, not a global queue gamble.
