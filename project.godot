; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; ENGINE PIN: Godot 4.6.2 stable (see CLAUDE.md — upgrades only between Gate 1 cycles).

config_version=5

[application]

config/name="Wildshot Adventures"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.6")

[autoload]

Config="*res://autoload/config.gd"
BootArgs="*res://autoload/boot_args.gd"

[gui]

; wildshot-ui kit theme (docs/13; built by addons/uikit_importer).
theme/custom="res://ui/theme.tres"

[display]

; Fullscreen default: windowed-mode compositing produced measured 25-30ms
; stall clusters on the dev machine (632 spikes/session, sim at 0.1 ms —
; spikes.jsonl evidence 2026-07-27). Alt+Enter toggles back to windowed.
window/size/mode=3
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
; 1-frame queue = -16.7 ms input latency. History: tried 2026-07-27 in
; WINDOWED mode and amplified compositor stutter (reverted); retried the
; same day once fullscreen became the default — fullscreen bypasses the
; compositor, and the HUD spike counter guards the retry. If spikes
; climb again, revert to 2.
rendering_device/vsync/frame_queue_size=1
